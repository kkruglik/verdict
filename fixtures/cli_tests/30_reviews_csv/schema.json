{
  "columns": [
    {
      "name": "product_id",
      "dtype": "int",
      "constraints": [
        {
          "constraint": "ge",
          "value": 1
        }
      ]
    },
    {
      "name": "rating",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "between",
          "value": [
            1.0,
            5.0
          ]
        }
      ]
    },
    {
      "name": "review_text",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "length_between",
          "value": [
            10,
            1000
          ]
        }
      ]
    },
    {
      "name": "sentiment",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "is_in",
          "value": [
            "positive",
            "negative",
            "neutral"
          ]
        }
      ]
    },
    {
      "name": "helpful_votes",
      "dtype": "int",
      "constraints": [
        {
          "constraint": "ge",
          "value": 0
        },
        {
          "constraint": "le",
          "value": 500
        }
      ]
    }
  ]
}