{
  "columns": [
    {
      "name": "company",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        }
      ]
    },
    {
      "name": "website",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "ends_with",
          "value": ".com"
        }
      ]
    },
    {
      "name": "email",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "matches_regex",
          "value": ".+@.+\\..+"
        }
      ]
    },
    {
      "name": "phone",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "starts_with",
          "value": "+1"
        }
      ]
    }
  ]
}