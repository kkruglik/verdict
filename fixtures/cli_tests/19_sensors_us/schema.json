{
  "columns": [
    {
      "name": "device_id",
      "dtype": "int",
      "constraints": [
        {
          "constraint": "unique",
          "value": true
        }
      ]
    },
    {
      "name": "reading",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "between",
          "value": [
            -100.0,
            100.0
          ]
        }
      ]
    },
    {
      "name": "quality_score",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "ge",
          "value": 0.0
        },
        {
          "constraint": "le",
          "value": 1.0
        }
      ]
    },
    {
      "name": "sampled_at",
      "dtype": "datetime",
      "constraints": [
        {
          "constraint": "after",
          "value": "2024-01-01T00:00:00"
        }
      ]
    }
  ]
}