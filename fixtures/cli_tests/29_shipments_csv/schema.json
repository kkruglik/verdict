{
  "columns": [
    {
      "name": "tracking_id",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        },
        {
          "constraint": "unique",
          "value": true
        },
        {
          "constraint": "starts_with",
          "value": "SHIP-"
        }
      ]
    },
    {
      "name": "ship_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "after",
          "value": "2022-01-01"
        }
      ],
      "format": "%Y-%m-%d"
    },
    {
      "name": "delivery_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "before",
          "value": "2030-01-01"
        }
      ],
      "format": "%Y-%m-%d"
    },
    {
      "name": "carrier",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "is_in",
          "value": [
            "UPS",
            "FedEx",
            "USPS",
            "DHL"
          ]
        }
      ]
    }
  ]
}