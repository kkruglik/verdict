{
  "columns": [
    {
      "name": "event_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        },
        {
          "constraint": "after",
          "value": "2020-01-01"
        }
      ],
      "format": "%Y-%m-%d"
    },
    {
      "name": "created_at",
      "dtype": "datetime",
      "constraints": [
        {
          "constraint": "between_dates",
          "value": [
            "2021-01-01T00:00:00",
            "2024-12-31T23:59:59"
          ]
        }
      ],
      "format": "%Y-%m-%dT%H:%M:%S"
    },
    {
      "name": "processed_at",
      "dtype": "datetime",
      "constraints": [
        {
          "constraint": "before",
          "value": "2026-01-01T00:00:00"
        }
      ],
      "format": "%Y-%m-%dT%H:%M:%S"
    }
  ]
}