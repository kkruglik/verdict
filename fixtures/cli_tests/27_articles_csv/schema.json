{
  "columns": [
    {
      "name": "article_id",
      "dtype": "int",
      "constraints": [
        {
          "constraint": "unique",
          "value": true
        }
      ]
    },
    {
      "name": "title",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        },
        {
          "constraint": "length_between",
          "value": [
            5,
            100
          ]
        }
      ]
    },
    {
      "name": "word_count",
      "dtype": "int",
      "constraints": [
        {
          "constraint": "gt",
          "value": 0
        },
        {
          "constraint": "le",
          "value": 5000
        }
      ]
    },
    {
      "name": "category",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "is_in",
          "value": [
            "tech",
            "health",
            "finance",
            "sports"
          ]
        }
      ]
    },
    {
      "name": "author",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        }
      ]
    }
  ]
}