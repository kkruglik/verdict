{
  "columns": [
    {
      "name": "user_id",
      "dtype": "int",
      "constraints": [
        {
          "constraint": "unique",
          "value": true
        }
      ]
    },
    {
      "name": "email",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "contains",
          "value": "@"
        }
      ]
    },
    {
      "name": "username",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "length_between",
          "value": [
            3,
            30
          ]
        }
      ]
    },
    {
      "name": "role",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "is_in",
          "value": [
            "admin",
            "user",
            "viewer"
          ]
        }
      ]
    },
    {
      "name": "active",
      "dtype": "bool",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        }
      ]
    }
  ]
}