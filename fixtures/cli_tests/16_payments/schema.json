{
  "columns": [
    {
      "name": "amount",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "gt",
          "value": 0.0
        },
        {
          "constraint": "le",
          "value": 5000.0
        }
      ]
    },
    {
      "name": "fee",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "between",
          "value": [
            0.0,
            50.0
          ]
        }
      ]
    },
    {
      "name": "payment_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        }
      ]
    },
    {
      "name": "settlement_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "before",
          "value": "2025-06-01"
        }
      ]
    }
  ]
}