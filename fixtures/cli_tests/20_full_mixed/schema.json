{
  "columns": [
    {
      "name": "id",
      "dtype": "int",
      "constraints": [
        {
          "constraint": "unique",
          "value": true
        }
      ]
    },
    {
      "name": "score",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "between",
          "value": [
            0.0,
            10.0
          ]
        }
      ]
    },
    {
      "name": "label",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "is_in",
          "value": [
            "cat1",
            "cat2",
            "cat3"
          ]
        }
      ]
    },
    {
      "name": "active",
      "dtype": "bool",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        }
      ]
    },
    {
      "name": "ref_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "after",
          "value": "2020-01-01"
        }
      ]
    },
    {
      "name": "created_at",
      "dtype": "datetime",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        }
      ]
    },
    {
      "name": "event_time",
      "dtype": "time",
      "constraints": [
        {
          "constraint": "between",
          "value": [
            "08:00:00",
            "20:00:00"
          ]
        }
      ]
    }
  ]
}