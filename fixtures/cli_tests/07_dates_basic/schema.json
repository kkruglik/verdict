{
  "columns": [
    {
      "name": "event_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        },
        {
          "constraint": "after",
          "value": "2020-01-01"
        }
      ]
    },
    {
      "name": "expiry_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "before",
          "value": "2030-01-01"
        }
      ]
    },
    {
      "name": "created_date",
      "dtype": "date",
      "constraints": [
        {
          "constraint": "between_dates",
          "value": [
            "2021-01-01",
            "2023-12-31"
          ]
        }
      ]
    }
  ]
}