          ]
        }
      ]
    },
    {
      "name": "science",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "le",
          "value": 100.0
        }
      ]
    },
    {
      "name": "english",
      "dtype": "float",
      "constraints": [
        {
          "constraint": "ge",
          "value": 0.0
        }
      ]
    },
    {
      "name": "grade",
      "dtype": "str",
      "constraints": [
        {
          "constraint": "is_in",
          "value": [
            "A",
            "B",
            "C",
            "D",
            "F"
          ]
        }
      ]
    }
  ]
}