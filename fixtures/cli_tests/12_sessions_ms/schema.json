{
  "columns": [
    {
      "name": "open_time",
      "dtype": "time",
      "constraints": [
        {
          "constraint": "after",
          "value": "06:00:00"
        }
      ]
    },
    {
      "name": "close_time",
      "dtype": "time",
      "constraints": [
        {
          "constraint": "before",
          "value": "23:00:00"
        }
      ]
    },
    {
      "name": "break_time",
      "dtype": "time",
      "constraints": [
        {
          "constraint": "not_null",
          "value": true
        }
      ]
    },
    {
      "name": "lunch_time",
      "dtype": "time",
      "constraints": [
        {
          "constraint": "between",
          "value": [
            "11:00:00",
            "14:00:00"
          ]
        }
      ]
    }
  ]
}