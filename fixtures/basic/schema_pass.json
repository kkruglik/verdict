{
  "table": {
    "constraints": [
      { "constraint": "shape_equals", "value": [100000, 9] },
      { "constraint": "rows_count_between", "value": [50000, 200000] },
      { "constraint": "rows_count_greater_or_equal", "value": 1 },
      { "constraint": "row_count_greater_than", "value": 0 },
      { "constraint": "rows_count_less_or_equal", "value": 1000000 },
      { "constraint": "row_count_less_than", "value": 2000000 },
      { "constraint": "columns_count_between", "value": [5, 20] },
      { "constraint": "columns_count_greater_or_equal", "value": 9 },
      { "constraint": "columns_count_greater_than", "value": 8 },
      { "constraint": "columns_count_less_or_equal", "value": 9 },
      { "constraint": "columns_count_less_than", "value": 10 },
      { "constraint": "columns_exist", "value": ["user_id", "score", "age", "is_active", "country"] }
    ]
  },
  "columns": [
    { "name": "user_id", "dtype": "int", "constraints": [
      { "constraint": "not_null", "value": true },
      { "constraint": "unique", "value": true },
      { "constraint": "ge", "value": 1 }
    ]},
    { "name": "score", "dtype": "float", "constraints": [
      { "constraint": "not_null", "value": true },
      { "constraint": "ge", "value": 0.0 },
      { "constraint": "le", "value": 100.0 }
    ]},
    { "name": "score_with_nulls", "dtype": "float" },
    { "name": "age", "dtype": "int", "constraints": [
      { "constraint": "ge", "value": 0 },
      { "constraint": "le", "value": 120 }
    ]},
    { "name": "age_with_nulls", "dtype": "int" },
    { "name": "is_active", "dtype": "bool" },
    { "name": "is_active_with_nulls", "dtype": "bool" },
    { "name": "country", "dtype": "str", "constraints": [
      { "constraint": "not_null", "value": true }
    ]},
    { "name": "country_with_nulls", "dtype": "str" }
  ]
}
